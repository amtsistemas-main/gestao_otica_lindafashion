# Copie para .env no servidor (nunca versione o .env).
# Domínio com DNS apontando para o servidor (o Caddy emite o certificado HTTPS sozinho).
EVOLUTION_DOMAIN=wa.seudominio.com.br
# Versão fixa e testada da imagem evoapicloud/evolution-api (ex.: v2.2.3).
EVOLUTION_VERSION=v2.2.3
# Chave global da API: gere com `openssl rand -hex 32`. É a mesma do secret EVOLUTION_API_KEY no Supabase.
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria-longa
# Senha do Postgres interno do gateway: `openssl rand -hex 24`.
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria
